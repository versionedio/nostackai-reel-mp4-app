# Only for running assemble.py yourself with a TTS engine (--engine gemini|openai|elevenlabs).
# The default, --engine saved, and the GitHub workflow use the narration saved in Reeldesk and
# need no key. Copy this file to ".env" (same folder) and fill in the one engine you use.
# Never commit the real .env: it holds a real API key (.gitignore already excludes it).

# --engine gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --engine openai
OPENAI_API_KEY=

# --engine elevenlabs — https://elevenlabs.io (Profile -> API Keys)
ELEVENLABS_API_KEY=

# --engine macos needs no key: it is offline, using the voice already installed on this Mac.
